{
  "manifest_version": 3,
  "name": "Spottr",
  "version": "1.0.0",
  "description": "Spotlight-like search for your browser: search bookmarks, history, and navigate with your keyboard.",
  "permissions": [
    "bookmarks",
    "history",
    "favicon",
    "browsingData",
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-spottr": {
      "suggested_key": {
        "default": "Ctrl+I",
        "mac": "Command+I"
      },
      "description": "Open Spottr"
    }
  }
}
